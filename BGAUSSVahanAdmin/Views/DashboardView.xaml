<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BGAUSSVahanAdmin.Views.DashboardView"
             BackgroundColor="#F4F6F9"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,50"
                             Spacing="25">

            <!-- ================= BRAND HEADER CARD ================= -->
            <Border BackgroundColor="White"
                    Padding="20"
                    StrokeShape="RoundRectangle 25"
                    Stroke="#E5E7EB">

                <HorizontalStackLayout Spacing="15"
                                       VerticalOptions="Center">

                    <!-- Scooter Thumbnail -->
                    <Image Source="ev.png"
                           HeightRequest="65"
                           WidthRequest="85"
                           Aspect="AspectFit"/>

                    <VerticalStackLayout>
                        <Label Text="BGAUSS"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#111827"/>

                        <Label Text="Electric Mobility Management"
                               FontSize="13"
                               TextColor="#6B7280"/>
                    </VerticalStackLayout>

                </HorizontalStackLayout>

            </Border>


            <!-- ================= HERO IMAGE ================= -->
            <Image Source="ev.png"
                   HeightRequest="230"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"/>


            <!-- ================= E-CATALOG BUTTON ================= -->
            <Button Text="E-Catalog"
                    HeightRequest="60"
                    CornerRadius="35"
                    FontSize="18"
                    FontAttributes="Bold"
                    Clicked="OnECatalogClicked"
                    TextColor="White"
                    BackgroundColor="#10B981" />


            <!-- ================= SECONDARY CARDS ================= -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="15">

                <!-- Reports -->
                <Border BackgroundColor="White"
                        Padding="20"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 25">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="📊"
                               FontSize="30"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Reports"
                               TextColor="#111827"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReportsClicked"/>
                    </Border.GestureRecognizers>

                </Border>

                <!-- Profile -->
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Padding="20"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 25">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="👤"
                               FontSize="30"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Profile"
                               TextColor="#111827"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileClicked"/>
                    </Border.GestureRecognizers>

                </Border>

            </Grid>

            <!-- ================= LOGOUT ================= -->
            <Button Text="Logout"
                    TextColor="#EF4444"
                    BackgroundColor="Transparent"
                    Clicked="OnLogoutClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>